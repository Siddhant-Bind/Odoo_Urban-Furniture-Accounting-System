  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon server/src/index.js",
    "start": "node server/src/index.js",
    "test": "node --test server/src/**/*.test.js",
    "prisma:generate": "cd server && prisma generate --schema prisma/schema.prisma",
