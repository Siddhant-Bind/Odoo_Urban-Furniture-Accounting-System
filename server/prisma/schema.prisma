generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------- ENUMS ----------

enum Role {
  admin
  invoicing_user
  contact_user
}

enum ContactType {
  customer
  vendor
}

enum ProductType {
  goods
  service
  combo
}

enum AccountType {
  asset
  liability
  income
  cash
  capital
  expenses
}

enum JournalType {
  sales
  purchase
  bank
  cash
}

enum Status {
  active
  archived
}

enum OrderStatus {
  draft
  confirmed
  billed
  cancelled
}

enum DocStatus {
  draft
  posted
  cancelled
}

enum PaymentMethod {
  cash
  bank
}

enum BudgetStatus {
  draft
  confirm
  revise
  cancelled
}

enum AnalyticType {
  income
  expense
}

// ---------- USERS ----------

model User {
  id              Int      @id @default(autoincrement())
  loginId         String   @unique
  email           String   @unique
  passwordHash    String
  role            Role
  linkedContact   Contact? @relation(fields: [linkedContactId], references: [id])
  linkedContactId Int?
  status          Status   @default(active)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budgets Budget[]
}

// ---------- MASTER DATA (4 tables) ----------

model Contact {
  id               Int         @id @default(autoincrement())
  name             String
  type             ContactType
  email            String?
  mobile           String?
  addressCity      String?
  addressState     String?
  addressPincode   String?
  profileImage     Bytes?      @db.MediumBlob
  profileImageMime String?
  status           Status      @default(active)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  users            User[]
  purchaseOrders   PurchaseOrder[]
  vendorBills      VendorBill[]
  salesOrders      SalesOrder[]
  customerInvoices CustomerInvoice[]
  journalEntryLines JournalEntryLine[]
}

model Product {
  id           Int         @id @default(autoincrement())
  productName  String
  type         ProductType
  category     String?
  salesPrice   Decimal     @db.Decimal(12, 2)
  cost         Decimal     @db.Decimal(12, 2)
  status       Status      @default(active)

  poLines      PurchaseOrderLine[]
  billLines    VendorBillLine[]
  soLines      SalesOrderLine[]
  invoiceLines InvoiceLine[]
}

model ChartOfAccount {
  id              Int              @id @default(autoincrement())
  accountName     String
  accountType     AccountType
  parentAccount   ChartOfAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  parentAccountId Int?
  children        ChartOfAccount[] @relation("AccountHierarchy")
  status          Status           @default(active)

  journalEntryLines JournalEntryLine[]
  journalsAsDebit   Journal[]          @relation("DefaultDebitAccount")
  journalsAsCredit  Journal[]          @relation("DefaultCreditAccount")
}

model Journal {
  id                     Int         @id @default(autoincrement())
  journalName            String
  journalType            JournalType
  defaultDebitAccount    ChartOfAccount? @relation("DefaultDebitAccount", fields: [defaultDebitAccountId], references: [id])
  defaultDebitAccountId  Int?
  defaultCreditAccount   ChartOfAccount? @relation("DefaultCreditAccount", fields: [defaultCreditAccountId], references: [id])
  defaultCreditAccountId Int?

  vendorBills      VendorBill[]
  customerInvoices CustomerInvoice[]
  journalEntries   JournalEntry[]
}

// ---------- TRANSACTIONS (8 tables) ----------

model PurchaseOrder {
  id       Int         @id @default(autoincrement())
  poNumber String      @unique   // auto-generated, e.g. PO-0001
  vendor   Contact     @relation(fields: [vendorId], references: [id])
  vendorId Int
  orderDate DateTime
  status   OrderStatus @default(draft)

  lines PurchaseOrderLine[]
  bills VendorBill[]
}

model PurchaseOrderLine {
  id              Int           @id @default(autoincrement())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int
  product         Product       @relation(fields: [productId], references: [id])
  productId       Int
  quantity        Decimal       @db.Decimal(10, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
}

model VendorBill {
  id              Int             @id @default(autoincrement())
  billNumber      String          @unique   // auto-generated, e.g. BILL-0001
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int?
  vendor          Contact         @relation(fields: [vendorId], references: [id])
  vendorId        Int
  invoiceDate     DateTime
  dueDate         DateTime
  totalAmount     Decimal         @db.Decimal(12, 2)
  status          DocStatus       @default(draft)
  journal         Journal         @relation(fields: [journalId], references: [id])
  journalId       Int

  lines    VendorBillLine[]
  payments BillPayment[]
}

model VendorBillLine {
  id        Int        @id @default(autoincrement())
  bill      VendorBill @relation(fields: [billId], references: [id])
  billId    Int
  product   Product    @relation(fields: [productId], references: [id])
  productId Int
  quantity  Decimal    @db.Decimal(10, 2)
  unitPrice Decimal    @db.Decimal(12, 2)
  total     Decimal    @db.Decimal(12, 2)
}

model BillPayment {
  id            Int           @id @default(autoincrement())
  bill          VendorBill    @relation(fields: [billId], references: [id])
  billId        Int
  amount        Decimal       @db.Decimal(12, 2)
  paymentVia    PaymentMethod
  paymentDate   DateTime
}

model SalesOrder {
  id        Int         @id @default(autoincrement())
  soNumber  String      @unique   // auto-generated, e.g. SO-0001
  customer  Contact     @relation(fields: [customerId], references: [id])
  customerId Int
  orderDate DateTime
  status    OrderStatus @default(draft)

  lines    SalesOrderLine[]
  invoices CustomerInvoice[]
}

model SalesOrderLine {
  id           Int        @id @default(autoincrement())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  salesOrderId Int
  product      Product    @relation(fields: [productId], references: [id])
  productId    Int
  quantity     Decimal    @db.Decimal(10, 2)
  unitPrice    Decimal    @db.Decimal(12, 2)
  tax          Decimal?   @db.Decimal(5, 2)
  total        Decimal    @db.Decimal(12, 2)
}

model CustomerInvoice {
  id           Int           @id @default(autoincrement())
  invoiceNumber String       @unique   // auto-generated, e.g. INV-0001
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  salesOrderId Int?
  customer     Contact       @relation(fields: [customerId], references: [id])
  customerId   Int
  invoiceDate  DateTime
  dueDate      DateTime
  totalAmount  Decimal       @db.Decimal(12, 2)
  status       DocStatus     @default(draft)
  journal      Journal       @relation(fields: [journalId], references: [id])
  journalId    Int

  lines    InvoiceLine[]
  payments InvoicePayment[]
}

model InvoiceLine {
  id        Int             @id @default(autoincrement())
  invoice   CustomerInvoice @relation(fields: [invoiceId], references: [id])
  invoiceId Int
  product   Product         @relation(fields: [productId], references: [id])
  productId Int
  quantity  Decimal         @db.Decimal(10, 2)
  unitPrice Decimal         @db.Decimal(12, 2)
  tax       Decimal?        @db.Decimal(5, 2)
  total     Decimal         @db.Decimal(12, 2)
}

model InvoicePayment {
  id          Int             @id @default(autoincrement())
  invoice     CustomerInvoice @relation(fields: [invoiceId], references: [id])
  invoiceId   Int
  amount      Decimal         @db.Decimal(12, 2)
  paymentVia  PaymentMethod
  paymentDate DateTime
}

// ---------- ACCOUNTING / LEDGER (2 tables) ----------

model JournalEntry {
  id         Int       @id @default(autoincrement())
  journal    Journal   @relation(fields: [journalId], references: [id])
  journalId  Int
  entryDate  DateTime
  reference  String?
  status     DocStatus @default(draft)  // Draft or Posted
  sourceType String?   // 'bill' | 'invoice' | 'manual'
  sourceId   Int?
  createdAt  DateTime  @default(now())

  lines JournalEntryLine[]
}

model JournalEntryLine {
  id                Int              @id @default(autoincrement())
  entry             JournalEntry     @relation(fields: [entryId], references: [id])
  entryId           Int
  account           ChartOfAccount   @relation(fields: [accountId], references: [id])
  accountId         Int
  partner           Contact?         @relation(fields: [partnerId], references: [id])
  partnerId         Int?
  debit             Decimal          @default(0) @db.Decimal(12, 2)
  credit            Decimal          @default(0) @db.Decimal(12, 2)
}

// ---------- BUDGETING (2 tables) ----------

model AnalyticAccount {
  id   Int          @id @default(autoincrement())
  name String
  type AnalyticType

  budgets Budget[]
}

model Budget {
  id                  Int             @id @default(autoincrement())
  budgetName          String
  periodStart         DateTime
  periodEnd           DateTime
  responsiblePerson   User            @relation(fields: [responsiblePersonId], references: [id])
  responsiblePersonId Int
  analyticAccount     AnalyticAccount @relation(fields: [analyticAccountId], references: [id])
  analyticAccountId   Int
  status              BudgetStatus    @default(draft)
  committedAmount     Decimal         @db.Decimal(12, 2)
  achievedAmount      Decimal         @default(0) @db.Decimal(12, 2)
}